+-- ============================================================
+-- Tabla: evaluaciones_instructores
+-- "Criterios para seleccionar instructor (a)" (ITD-AD-FO-06)
+-- Una evaluación por preregistro (constraint único en preregistro_id,
+-- requerido por el upsert que hace el frontend).
+-- ============================================================
+
+create table if not exists public.evaluaciones_instructores (
+  id uuid primary key default gen_random_uuid(),
+  preregistro_id uuid not null references public.preregistro_cursos(id) on delete cascade,
+  docente_id uuid not null references public.docentes(id) on delete cascade,
+
+  instructor_nombre text not null,
+  fecha_evaluacion date not null,
+  curso_nombre text not null,
+  empresa_plantel text not null default 'ITD',
+
+  criterio_1 smallint not null check (criterio_1 between 1 and 5),
+  criterio_2 smallint not null check (criterio_2 between 1 and 5),
+  criterio_3 smallint not null check (criterio_3 between 1 and 5),
+  criterio_4 smallint not null check (criterio_4 between 1 and 5),
+  criterio_5 smallint not null check (criterio_5 between 1 and 5),
+  puntuacion_total smallint not null check (puntuacion_total between 5 and 25),
+
+  aceptado boolean not null default false,
+  jefe_departamento text not null,
+  cargo_evaluador text not null,
+
+  created_at timestamptz not null default now(),
+
+  constraint evaluaciones_instructores_preregistro_unico unique (preregistro_id)
+);
+
+create index if not exists evaluaciones_instructores_docente_idx
+  on public.evaluaciones_instructores (docente_id);
+
+-- ============================================================
+-- RLS — mismo patrón que el resto del proyecto: se resuelve el
+-- docente autenticado por email (auth.jwt() ->> 'email') contra
+-- la tabla docentes, y los administradores (tabla administradores)
+-- tienen acceso total.
+-- Ajusta esto si tus políticas en preregistro_cursos usan otro patrón.
+-- ============================================================
+
+alter table public.evaluaciones_instructores enable row level security;
+
+-- El docente dueño del preregistro puede ver y crear/actualizar su propia evaluación
+create policy "docente ve sus evaluaciones"
+  on public.evaluaciones_instructores for select
+  using (
+    docente_id in (
+      select id from public.docentes
+      where lower(email) = lower(auth.jwt() ->> 'email')
+    )
+  );
+
+create policy "docente crea/actualiza su evaluacion"
+  on public.evaluaciones_instructores for insert
+  with check (
+    docente_id in (
+      select id from public.docentes
+      where lower(email) = lower(auth.jwt() ->> 'email')
+    )
+  );
+
+create policy "docente actualiza su evaluacion"
+  on public.evaluaciones_instructores for update
+  using (
+    docente_id in (
+      select id from public.docentes
+      where lower(email) = lower(auth.jwt() ->> 'email')
+    )
+  );
+
+-- Los administradores (tabla administradores) tienen acceso total
+create policy "administradores acceso total evaluaciones"
+  on public.evaluaciones_instructores for all
+  using (
+    exists (
+      select 1 from public.administradores
+      where lower(email) = lower(auth.jwt() ->> 'email')
+    )
+  );
+
+-- ============================================================
+-- Tabla: configuracion
+-- Clave/valor genérico para datos institucionales que antes
+-- estaban "quemados" en plantillas PDF (ej. nombre y cargo de
+-- quien firma el Vo.Bo. en Criterios de Instructor). Si cambia
+-- la persona, se actualiza aquí, no en el PDF ni en el código.
+-- ============================================================
+
+create table if not exists public.configuracion (
+  clave text primary key,
+  valor text not null,
+  actualizado_en timestamptz not null default now()
+);
+
+insert into public.configuracion (clave, valor) values
+  ('vobo_nombre', 'Adriana Eréndira Murillo'),
+  ('vobo_cargo', 'Subdirección Académica')
+on conflict (clave) do nothing;
+
+alter table public.configuracion enable row level security;
+
+-- Cualquier usuario autenticado del dominio puede leer (se usa para generar PDFs)
+create policy "usuarios autenticados leen configuracion"
+  on public.configuracion for select
+  using (auth.role() = 'authenticated');
+
+-- Solo administradores pueden modificarla
+create policy "administradores modifican configuracion"
+  on public.configuracion for all
+  using (
+    exists (
+      select 1 from public.administradores
+      where lower(email) = lower(auth.jwt() ->> 'email')
+    )
+  );
